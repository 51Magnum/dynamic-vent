# Required: Microsoft 365 SMTP mailbox username (server only).
EMAIL_USER=
# Required: Microsoft 365 app password (server only).
EMAIL_PASS=
# Optional: internal recipient and business Reply-To; defaults to sales@dynamicvent.com.
SALES_EMAIL=
# Optional: IP submissions per window; defaults to 5.
RATE_LIMIT_MAX=
# Optional: IP window length; defaults to 600 seconds.
RATE_LIMIT_WINDOW_SECONDS=
# Optional: shared Upstash Redis REST URL; requires the token too.
UPSTASH_REDIS_REST_URL=
# Optional: shared Upstash Redis REST token; requires the URL too.
UPSTASH_REDIS_REST_TOKEN=
# Optional: durable lead webhook URL; leave unset to disable.
LEAD_WEBHOOK_URL=
# Optional: webhook authentication secret; required when enabling the documented sink.
LEAD_WEBHOOK_SECRET=
